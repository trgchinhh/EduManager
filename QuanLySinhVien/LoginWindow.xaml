<Window x:Class="QuanLySinhVien.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduManager"
        Icon="/Assets/EduManager.ico"
        Width="980"
        Height="600"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{DynamicResource SurfaceBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0">
            <Border.Background>
                <ImageBrush ImageSource="/Assets/Login-background.jpg"
                            Stretch="UniformToFill" />
            </Border.Background>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource SurfaceBrush}">
            <Button x:Name="ThemeToggleButton" Style="{StaticResource RoundThemeToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,18,0" Click="ThemeToggle_Click" ToolTip="Đổi giao diện sáng / tối">
                <TextBlock x:Name="ThemeToggleIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
            <StackPanel x:Name="MainFormPanel" Width="380" Margin="0,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="WelcomeText" Text="CHÀO MỪNG TRỞ LẠI"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />

                    <TextBlock x:Name="FormTitleText" Text="Đăng nhập"
                               Style="{StaticResource PageTitle}"
                               FontSize="32"
                               Margin="0,10,0,0" />
                    <TextBlock x:Name="FormSubtitleText" Text="Sử dụng tài khoản giảng viên để tiếp tục."
                               Style="{StaticResource PageSubtitle}" />

                    <Border x:Name="ErrorBorder"
                            Background="{DynamicResource DangerSoftBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="12,9"
                            Margin="0,20,0,0"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       Foreground="{DynamicResource DangerBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ErrorText"
                                       Text="Tên đăng nhập hoặc mật khẩu không đúng."
                                       Margin="9,0,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource DangerBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" Margin="2,18,0,6" />
                    <TextBox x:Name="UsernameBox"
                             Style="{StaticResource InputTextBox}"
                             Height="46"
                             TabIndex="0" />

                    <TextBlock x:Name="PasswordLabel" Text="Mật khẩu" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                    <Grid Height="46">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Padding="8,0,42,0" TabIndex="1" />
                        <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource InputTextBox}" Padding="8,0,42,0" Visibility="Collapsed" TabIndex="1" />
                        <Button Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TogglePasswordVisibility_Click" ToolTip="Hiện hoặc ẩn mật khẩu">
                            <Grid Width="21" Height="18">
                                <Path Data="M1,9 C4,4 7,2 10.5,2 C14,2 17,4 20,9 C17,14 14,16 10.5,16 C7,16 4,14 1,9 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path x:Name="PasswordEyeSlash" Data="M3,17 L18,2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Visibility="Collapsed" />
                            </Grid>
                        </Button>
                    </Grid>

                    <StackPanel x:Name="RegistrationFieldsPanel" Visibility="Collapsed">
                        <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}" Height="42" />
                        <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <Grid Height="42">
                            <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource InputPasswordBox}" Padding="8,0,42,0" />
                            <TextBox x:Name="ConfirmPasswordVisibleBox" Style="{StaticResource InputTextBox}" Padding="8,0,42,0" Visibility="Collapsed" />
                            <Button Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleConfirmPasswordVisibility_Click" ToolTip="Hiện hoặc ẩn mật khẩu">
                                <Grid Width="21" Height="18">
                                    <Path Data="M1,9 C4,4 7,2 10.5,2 C14,2 17,4 20,9 C17,14 14,16 10.5,16 C7,16 4,14 1,9 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent" />
                                    <Ellipse Width="5" Height="5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Path x:Name="ConfirmEyeSlash" Data="M3,17 L18,2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>
                        <TextBlock Text="Khoa / Bộ môn" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <ComboBox x:Name="DepartmentBox" Style="{StaticResource InputComboBox}" Height="42" />
                        <TextBlock Text="Học hàm, học vị" Style="{StaticResource FieldLabel}" Margin="2,12,0,6" />
                        <ComboBox x:Name="DegreeBox" Style="{StaticResource InputComboBox}" Height="42" />
                    </StackPanel>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="LoginButton" Content="Đăng nhập" Style="{StaticResource PrimaryButton}" Height="46" IsDefault="True" Click="Login_Click" />
                        <Button x:Name="ModeButton" Grid.Column="2" Content="Đăng ký" Style="{StaticResource SecondaryButton}" Height="46" Click="Register_Click" />
                    </Grid>

                    <StackPanel x:Name="DemoPanel">
                    <Grid Margin="0,18,0,0">
                        <Border Height="1" Background="{DynamicResource AppBorderBrush}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SurfaceBrush}" Padding="12,0" HorizontalAlignment="Center">
                            <TextBlock Text="TÀI KHOẢN DEMO"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="Nhấn để điền nhanh tài khoản. Mật khẩu chung: 123456"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,8"
                               TextWrapping="Wrap"
                               TextAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="gv.minh  ·  CNTT"
                                Tag="gv.minh"
                                Style="{StaticResource SecondaryButton}"
                                Height="34"
                                FontSize="11.5"
                                Padding="13,0"
                                Margin="0,0,6,0"
                                Click="DemoAccount_Click" />
                        <Button Content="gv.lan  ·  Kinh tế"
                                Tag="gv.lan"
                                Style="{StaticResource SecondaryButton}"
                                Height="34"
                                FontSize="11.5"
                                Padding="13,0"
                                Click="DemoAccount_Click" />
                    </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="DataNoteText" Margin="0,18,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Text="Dữ liệu được lưu tự động trên máy của bạn." />
                </StackPanel>
        </Grid>
    </Grid>
</Window>
