<Window x:Class="QuanLySinhVien.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EduManager" Width="1280" Height="800"
        Icon="/Assets/EduManager.ico"
        MinWidth="1050" MinHeight="650" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#E9E8ED"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AppBorderBrush" Color="#D4D2DA"/>
        <SolidColorBrush x:Key="AppBorderSoftBrush" Color="#E4E2E8"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#25242A"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#68666F"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#898791"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F4622A"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#D64E21"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#FFF0E9"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#50AF63"/>
        <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E3F5E6"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#E9A923"/>
        <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF3D5"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#35A9E8"/>
        <SolidColorBrush x:Key="InfoSoftBrush" Color="#DDF3FC"/>
        <SolidColorBrush x:Key="SurfaceSoftBrush" Color="#F1F0F4"/>
        <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F7F6F9"/><GradientStop Color="#EEEDF2" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8056"/><GradientStop Color="#E94C1E" Offset="1"/></LinearGradientBrush>
        <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavRadioButton" TargetType="RadioButton">
            <Setter Property="Height" Value="43"/><Setter Property="Margin" Value="5,2"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="box" Background="Transparent" CornerRadius="3" Padding="9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition x:Name="iconColumn" Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="icon" Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><ContentPresenter x:Name="label" Grid.Column="1" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"><Setter TargetName="box" Property="Padding" Value="0"/><Setter TargetName="icon" Property="Grid.ColumnSpan" Value="2"/><Setter TargetName="icon" Property="HorizontalAlignment" Value="Center"/><Setter TargetName="label" Property="Visibility" Value="Collapsed"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource AppBorderSoftBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="box" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Menu Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI">
                    <MenuItem Header="Hệ thống" Padding="10,5"><MenuItem Header="Đăng xuất" Click="Logout_Click"/><Separator/><MenuItem Header="Thoát ứng dụng" Click="Exit_Click"/></MenuItem>
                    <MenuItem Header="Quản lý" Padding="10,5"><MenuItem Header="Thêm sinh viên..." Click="AddStudent_Click"/><MenuItem Header="Thêm lớp học..." Click="AddClass_Click"/><Separator/><MenuItem Header="Quản lý sinh viên" Click="MenuStudents_Click"/><MenuItem Header="Quản lý lớp học" Click="MenuClasses_Click"/></MenuItem>
                    <MenuItem Header="Thống kê" Padding="10,5" Click="MenuStatistics_Click"/><MenuItem Header="Trợ giúp" Padding="10,5"><MenuItem Header="Hướng dẫn sử dụng" Click="Help_Click"/><MenuItem Header="Giới thiệu" Click="About_Click"/></MenuItem>
                </Menu>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="DateText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/><Button x:Name="ThemeToggleButton" Style="{StaticResource RoundThemeToggleButton}" Margin="12,0,0,0" Click="ThemeToggle_Click" ToolTip="Đổi giao diện sáng / tối"><TextBlock x:Name="ThemeToggleIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" /></Button></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Margin="8,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Button x:Name="SidebarToggleButton" Grid.Row="0" Width="34" Height="34" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource TextSecondaryBrush}" Click="SidebarToggle_Click" ToolTip="Thu gọn thanh bên"><TextBlock x:Name="SidebarToggleIcon" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" /></Button>
                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavRadioButton}" GroupName="MainNav" Content="Tổng quan" Tag="&#xE80F;" CommandParameter="dashboard" IsChecked="True" Click="Nav_Click"/>
                        <RadioButton x:Name="NavClasses" Style="{StaticResource NavRadioButton}" GroupName="MainNav" Content="Quản lý lớp" Tag="&#xE8F1;" CommandParameter="classes" Click="Nav_Click"/>
                        <RadioButton x:Name="NavStudents" Style="{StaticResource NavRadioButton}" GroupName="MainNav" Content="Quản lý sinh viên" Tag="&#xE716;" CommandParameter="students" Click="Nav_Click"/>
                        <RadioButton x:Name="NavStatistics" Style="{StaticResource NavRadioButton}" GroupName="MainNav" Content="Thống kê" Tag="&#xE9D2;" CommandParameter="statistics" Click="Nav_Click"/>
                        <RadioButton x:Name="NavProfile" Style="{StaticResource NavRadioButton}" GroupName="MainNav" Content="Thông tin giảng viên" Tag="&#xE77B;" CommandParameter="profile" Click="Nav_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Margin="4,0,4,4">
                        <Button x:Name="SidebarLogoutButton" Style="{StaticResource BaseButton}" Click="Logout_Click" Height="34" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="0" Background="Transparent" BorderBrush="{DynamicResource AppBorderBrush}" Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="Đăng xuất"><Grid><TextBlock x:Name="LogoutText" Text="Đăng xuất"/><TextBlock x:Name="LogoutIcon" Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" Visibility="Collapsed"/></Grid></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}" Margin="12"><Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="14"><ContentControl x:Name="ContentHost"/></Border></Grid>
        </Grid>
    </Grid>
</Window>
