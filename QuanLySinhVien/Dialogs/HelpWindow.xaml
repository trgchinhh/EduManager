<Window x:Class="QuanLySinhVien.Dialogs.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trợ giúp | EduManager"
        Icon="/Assets/EduManager.ico"
        Width="780" Height="620" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="40" Height="40" Background="{DynamicResource AccentBrush}" CornerRadius="3"><TextBlock Text="?" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Trợ giúp sử dụng" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Hướng dẫn nhanh các chức năng trong EduManager." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
                <Button Grid.Column="2" Content="Đóng" Style="{StaticResource SecondaryButton}" Width="76" Height="32" Click="Close_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid Columns="2">
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,8,8">
                    <StackPanel><TextBlock Text="01  ·  Tổng quan" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Xem nhanh số lớp, số sinh viên, điểm trung bình và tình hình học tập." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="02  ·  Quản lý lớp" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Tạo, cập nhật hoặc xóa lớp học. Mỗi lớp có thể chứa danh sách sinh viên riêng." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,8,8">
                    <StackPanel><TextBlock Text="03  ·  Quản lý sinh viên" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Chọn một thẻ lớp để xem sinh viên. Có thể tìm kiếm, lọc, thêm, sửa, xóa và xuất CSV danh sách đang hiển thị." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="04  ·  Thống kê" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Xem điểm trung bình, tỷ lệ đạt, phân bố học lực và sinh viên cần chú ý theo lớp." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="15" Margin="0,0,8,8">
                    <StackPanel><TextBlock Text="05  ·  Hồ sơ giảng viên" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Cập nhật thông tin cá nhân, đổi ảnh đại diện và thay đổi mật khẩu." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
                <Border Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Mẹo thao tác" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}"/><TextBlock Text="Nhấn đúp vào một dòng sinh viên để mở nhanh màn hình chỉnh sửa." FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="EduManager  ·  Quản lý sinh viên" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" Margin="2,12,0,0" />
    </Grid>
</Window>
