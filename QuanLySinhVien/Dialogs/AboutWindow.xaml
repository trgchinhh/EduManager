<Window x:Class="QuanLySinhVien.Dialogs.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu | EduManager"
        Icon="/Assets/EduManager.ico"
        Width="620" Height="720" MinWidth="560" MinHeight="640"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="18">
            <StackPanel Orientation="Horizontal">
                <Border Width="54" Height="54" CornerRadius="3"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF8056"/><GradientStop Color="#E94C1E" Offset="1"/></LinearGradientBrush></Border.Background><TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="25" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center"><TextBlock Text="EduManager" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Quản lý sinh viên · Phiên bản 1.0" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,14">
            <StackPanel>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="16">
                    <StackPanel><TextBlock Text="Về ứng dụng" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="EduManager hỗ trợ giảng viên quản lý lớp, hồ sơ sinh viên và theo dõi kết quả học tập." FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock Text="WPF · .NET 8" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="0,10,0,0"/></StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="20" Margin="0,12,0,0">
                    <StackPanel HorizontalAlignment="Stretch">
                        <Border x:Name="AuthorAvatarBorder" Width="202" Height="202" CornerRadius="101" Background="{DynamicResource AccentGradientBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="2" HorizontalAlignment="Center" ClipToBounds="True">
                            <Grid>
                                <TextBlock x:Name="AuthorInitials" Text="TC" FontSize="42" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="AuthorAvatarImage" Stretch="UniformToFill" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Trường Chinh" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Tác giả ứng dụng" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock Text="Kết nối với tác giả" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,18,0,9" />
                        <UniformGrid Columns="3">
                            <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8" Margin="0,0,5,0" Tag="https://www.facebook.com/trgchinhh" Cursor="Hand" MouseLeftButtonUp="SocialLink_MouseLeftButtonUp"><StackPanel HorizontalAlignment="Center"><TextBlock Text="f" FontSize="20" FontWeight="Bold" Foreground="#1877F2" HorizontalAlignment="Center"/><TextBlock Text="Facebook" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="trgchinhh" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8" Margin="3,0" Tag="https://www.instagram.com/trgchinhh/" Cursor="Hand" MouseLeftButtonUp="SocialLink_MouseLeftButtonUp"><StackPanel HorizontalAlignment="Center"><Grid Width="26" Height="26"><Border Width="21" Height="21" CornerRadius="6" BorderBrush="#D9468D" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Stroke="#D9468D" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="3" Height="3" Fill="#D9468D" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"/></Grid><TextBlock Text="Instagram" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="trgchinhh" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>
                            <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="8" Margin="5,0,0,0" Tag="https://github.com/trgchinhh" Cursor="Hand" MouseLeftButtonUp="SocialLink_MouseLeftButtonUp"><StackPanel HorizontalAlignment="Center"><Viewbox Width="26" Height="26" Stretch="Uniform"><Grid Width="32" Height="32"><Path Fill="{DynamicResource TextPrimaryBrush}" Data="M16,1 C13.3,1 10.8,2 9,3.8 L4,2.5 4.8,8 C3.6,9.8 3,12 3,14.5 C3,21 7.2,25.5 13,26.5 L13,23.5 C11,24 9.6,23.2 8.7,21.7 C8.2,20.8 7.5,20.1 6.4,19.8 C5.9,19.6 5.8,19.1 6.5,19 C8,18.8 9,20.2 9.6,21 C10.4,22.2 11.7,22.5 13,22 C13.2,20.9 13.8,20 14.7,19.5 C9.3,18.9 6.4,16.2 6.4,12.1 C6.4,10.4 7,9 8,7.9 C7.7,6.7 7.9,5.3 8.6,4.2 C10.1,4.2 11.5,5 12.5,5.7 C14.7,5.1 17.3,5.1 19.5,5.7 C20.5,5 21.9,4.2 23.4,4.2 C24.1,5.3 24.3,6.7 24,7.9 C25,9 25.6,10.4 25.6,12.1 C25.6,16.2 22.7,18.9 17.3,19.5 C18.8,20.3 19,21.7 19,23.2 L19,26.5 C24.8,25.5 29,21 29,14.5 C29,12 28.4,9.8 27.2,8 L28,2.5 23,3.8 C21.2,2 18.7,1 16,1 Z"/></Grid></Viewbox><TextBlock Text="GitHub" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="trgchinhh" FontSize="8.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,0"/></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" Padding="13" Margin="0,12,0,0">
                    <StackPanel><TextBlock Text="TÀI KHOẢN DEMO" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="gv.minh / 123456     ·     gv.lan / 123456" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/></StackPanel>
                </Border>
                <TextBlock x:Name="DataPathText" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="2,10,2,0" />
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" Content="Đóng" Style="{StaticResource PrimaryButton}" Width="100" Height="34" HorizontalAlignment="Right" Click="Close_Click" />
    </Grid>
</Window>
