<Window x:Class="QuanLySinhVien.Dialogs.LecturerRegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đăng ký giảng viên" Width="460" Height="730" MinWidth="460" MinHeight="730"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" FontFamily="{StaticResource AppFont}"
        Icon="/Assets/EduManager.ico">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel VerticalAlignment="Center" Margin="0,0,48,0">
                <TextBlock Text="Tạo tài khoản giảng viên" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Text="Điền thông tin bên dưới để đăng ký tài khoản mới." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
            <Button x:Name="ThemeToggleButton" Style="{StaticResource RoundThemeToggleButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ThemeToggle_Click" ToolTip="Đổi giao diện sáng / tối">
                <TextBlock x:Name="ThemeToggleIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Họ và tên" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="FullNameBox" Style="{StaticResource InputTextBox}" Height="42" />
            <TextBlock Text="Tên đăng nhập" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
            <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBox}" Height="42" />
            <TextBlock Text="Mật khẩu (ít nhất 6 ký tự)" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
            <Grid Height="42">
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}" Padding="8,0,42,0" />
                <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource InputTextBox}" Padding="8,0,42,0" Visibility="Collapsed" />
                <Button Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="TogglePasswordVisibility_Click" ToolTip="Hiện hoặc ẩn mật khẩu"><Grid Width="21" Height="18"><Path Data="M1,9 C4,4 7,2 10.5,2 C14,2 17,4 20,9 C17,14 14,16 10.5,16 C7,16 4,14 1,9 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"/><Ellipse Width="5" Height="5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path x:Name="PasswordEyeSlash" Data="M3,17 L18,2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Visibility="Collapsed"/></Grid></Button>
            </Grid>
            <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
            <Grid Height="42">
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource InputPasswordBox}" Padding="8,0,42,0" />
                <TextBox x:Name="ConfirmPasswordVisibleBox" Style="{StaticResource InputTextBox}" Padding="8,0,42,0" Visibility="Collapsed" />
                <Button Width="36" Height="36" HorizontalAlignment="Right" Margin="0,0,3,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ToggleConfirmPasswordVisibility_Click" ToolTip="Hiện hoặc ẩn mật khẩu"><Grid Width="21" Height="18"><Path Data="M1,9 C4,4 7,2 10.5,2 C14,2 17,4 20,9 C17,14 14,16 10.5,16 C7,16 4,14 1,9 Z" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" Fill="Transparent"/><Ellipse Width="5" Height="5" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/><Path x:Name="ConfirmEyeSlash" Data="M3,17 L18,2" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" Visibility="Collapsed"/></Grid></Button>
            </Grid>
            <TextBlock Text="Khoa / Bộ môn" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
            <ComboBox x:Name="DepartmentBox" Style="{StaticResource InputComboBox}" Height="42" />
            <TextBlock Text="Học hàm, học vị" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
            <ComboBox x:Name="DegreeBox" Style="{StaticResource InputComboBox}" Height="42" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="11.5" Margin="2,12,2,0" Visibility="Collapsed" />
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource SecondaryButton}" Width="90" Margin="0,0,8,0" IsCancel="True" />
            <Button Content="Đăng ký" Style="{StaticResource PrimaryButton}" Width="110" IsDefault="True" Click="Register_Click" />
        </StackPanel>
    </Grid>
</Window>
