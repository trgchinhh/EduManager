<UserControl x:Class="QuanLySinhVien.Views.StudentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:QuanLySinhVien.Converters"
             FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <converters:RowNumberConverter x:Key="RowNumberConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="Quản lý sinh viên" Style="{StaticResource PageTitle}" FontSize="19" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}"
                        Height="34"
                        Padding="11,0"
                        Margin="0,0,8,0"
                        Click="ExportStudents_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Xuất CSV" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Padding="12,0"
                        Click="AddStudent_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="Thêm sinh viên" FontSize="12.5" FontWeight="SemiBold" Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6,3" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Tổng sinh viên" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="StatTotalText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                <Border Grid.Column="1" Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Đang học" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="StatActiveText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="8,0,0,0"/></StackPanel>
                <Border Grid.Column="3" Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Điểm trung bình" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="StatAverageText" Text="--" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0"/></StackPanel>
                <Border Grid.Column="5" Background="{DynamicResource AppBorderBrush}" Margin="0,4"/>
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Cần chú ý" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="StatAtRiskText" Text="0" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="540" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,16,0" HorizontalAlignment="Stretch">
                        <TextBox x:Name="SearchBox"
                                 Style="{StaticResource InputTextBox}"
                                 Height="30"
                                 Padding="36,0,12,0"
                                 TextChanged="SearchBox_TextChanged" />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="13,0,0,0"
                                   IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchWatermark"
                                   Text="Tìm theo tên, mã sinh viên, email, số điện thoại..."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="36,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="FilterToggleButton"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Padding="9,0"
                                Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Click="ToggleFilters_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="FilterToggleText" Text="Bộ lọc" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditStudentButton"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                Margin="0,0,8,0"
                                IsEnabled="False"
                                Click="EditStudent_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Sửa" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteStudentButton"
                                Style="{StaticResource SecondaryButton}"
                                Height="30"
                                IsEnabled="False"
                                Click="DeleteStudent_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="Xóa" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="StudentFilterControls" Margin="0,4,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE71C;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Bộ lọc"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center" />

                        <ComboBox x:Name="ClassFilter"
                                  Style="{StaticResource InputComboBox}"
                                  Height="32"
                                  Width="220"
                                  Margin="12,0,0,0"
                                  SelectionChanged="Filter_SelectionChanged" />
                        <ComboBox x:Name="GenderFilter"
                                  Style="{StaticResource InputComboBox}"
                                  Height="32"
                                  Width="132"
                                  Margin="8,0,0,0"
                                  SelectionChanged="Filter_SelectionChanged" />
                        <ComboBox x:Name="StatusFilter"
                                  Style="{StaticResource InputComboBox}"
                                  Height="32"
                                  Width="150"
                                  Margin="8,0,0,0"
                                  SelectionChanged="Filter_SelectionChanged" />
                        <ComboBox x:Name="SortFilter"
                                  Style="{StaticResource InputComboBox}"
                                  Height="32"
                                  Width="178"
                                  Margin="8,0,0,0"
                                  SelectionChanged="SortFilter_SelectionChanged" />

                        <Button Content="Xóa bộ lọc"
                                Style="{StaticResource GhostButton}"
                                Height="32"
                                Margin="8,0,0,0"
                                Click="ResetFilters_Click" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid x:Name="ClassesPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="4,2,4,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Danh sách lớp" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Chọn một lớp để xem danh sách sinh viên." Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="ClassCountText" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <ItemsControl x:Name="ClassCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Tag="{Binding Classroom}" Click="ClassCard_Click" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,12,12" Cursor="Hand">
                                        <Border Width="270" MinHeight="142" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="34" Height="34" Background="{Binding IconBackground}" CornerRadius="2"><TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji" FontSize="17" Foreground="{Binding IconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Classroom.Id}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding IconForeground}"/><TextBlock Text="{Binding Classroom.Room, StringFormat=Phòng {0}}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/></StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Margin="0,12,0,10"><TextBlock Text="{Binding Classroom.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding Classroom.Subject}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                                                <Grid Grid.Row="2"><TextBlock Text="Mở danh sách sinh viên  ›" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding IconForeground}" VerticalAlignment="Center"/><TextBlock Text="{Binding Classroom.StudentCountText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoClassesState" Text="Chưa có lớp học. Hãy thêm lớp học trước khi quản lý sinh viên." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="NoMatchingClassesState" Text="Không tìm thấy lớp phù hợp." Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>
            </Grid>

        <Border x:Name="StudentListPanel" Grid.Row="3" Style="{StaticResource Card}" Padding="0" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="10,7,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="← Lớp" Style="{StaticResource SecondaryButton}" Height="30" Padding="9,0" Margin="0,0,10,0" Click="BackToClasses_Click" />
                        <TextBlock x:Name="SelectedClassTitle" Text="Danh sách sinh viên" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StudentsCountText" Text="0 sinh viên" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Nhấn đúp để sửa nhanh" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="StudentsGrid"
                              Style="{StaticResource AppDataGrid}"
                              AlternationCount="1000000"
                              RowHeight="48"
                              ColumnHeaderHeight="36"
                              SelectionChanged="StudentsGrid_SelectionChanged"
                              MouseDoubleClick="StudentsGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STT" Width="55" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex, Converter={StaticResource RowNumberConverter}}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="SINH VIÊN" Width="250" SortMemberPath="FullName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                            <TextBlock Text="{Binding Email}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="230" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="MÃ SV" Binding="{Binding Id}" Width="86" />
                            <DataGridTextColumn Header="LỚP" Binding="{Binding ClassName}" Width="*" MinWidth="140" />

                            <DataGridTemplateColumn Header="GIỚI TÍNH" Width="80" SortMemberPath="Gender">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Gender}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="NGÀY SINH" Width="103" Binding="{Binding DateOfBirth, StringFormat={}{0:dd/MM/yyyy}}" SortMemberPath="DateOfBirth" />

                            <DataGridTemplateColumn Header="ĐIỂM TB" Width="92" SortMemberPath="Score">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding ScoreText}" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Rank}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,0" />
                                            </StackPanel>
                                            <ProgressBar Style="{StaticResource AppProgressBar}"
                                                         Height="4"
                                                         Maximum="10"
                                                         Value="{Binding Score}"
                                                         Width="74"
                                                         HorizontalAlignment="Left"
                                                         Margin="0,5,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="TRẠNG THÁI" Width="118" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="7" Padding="8,4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Bảo lưu">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Tốt nghiệp">
                                                            <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Thôi học">
                                                            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Bảo lưu">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Tốt nghiệp">
                                                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Thôi học">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="82">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Tag="{Binding}" Click="EditStudentRow_Click" ToolTip="Sửa sinh viên">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Tag="{Binding}" Click="DeleteStudentRow_Click" ToolTip="Xóa sinh viên">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource SurfaceSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="23" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Không tìm thấy sinh viên" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Thử thay đổi bộ lọc hoặc thêm sinh viên mới." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </Grid>
    </Grid>
</UserControl>
