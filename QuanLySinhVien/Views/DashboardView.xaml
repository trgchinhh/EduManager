<UserControl x:Class="QuanLySinhVien.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GreetingText" Style="{StaticResource PageTitle}" Text="Xin chào" />
                    <TextBlock x:Name="HeaderSubtitle" Style="{StaticResource PageSubtitle}" Text="Chúc bạn một ngày làm việc hiệu quả." />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="102"
                        Height="102"
                        CornerRadius="51"
                        Background="{DynamicResource AccentGradientBrush}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Margin="0,0,25,0">
                    <Grid>
                        <TextBlock x:Name="LecturerAvatarInitials"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Ellipse x:Name="LecturerAvatarImage" Width="98" Height="98" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="19" MinHeight="132">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tổng sinh viên"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalStudentsText" Grid.Row="1" Style="{StaticResource StatValue}" Text="0" VerticalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="2" Text="Sinh viên thuộc các lớp của bạn" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="19" MinHeight="132">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Lớp đang phụ trách"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TotalClassesText" Grid.Row="1" Style="{StaticResource StatValue}" Text="0" VerticalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="2" Text="Lớp học được phân công" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="19" MinHeight="132">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}">
                                <TextBlock Text="&#xE9D2;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="{DynamicResource WarningBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Điểm trung bình"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="AverageScoreText" Grid.Row="1" Style="{StaticResource StatValue}" Text="--" VerticalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="2" Text="Thang điểm 10" Style="{StaticResource MutedText}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="19" MinHeight="132">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource InfoSoftBrush}">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="17"
                                           Foreground="{DynamicResource InfoBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Tỉ lệ đạt"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="PassRateText" Grid.Row="1" Style="{StaticResource StatValue}" Text="0%" VerticalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Grid.Row="2" Text="Sinh viên có điểm từ 5.0" Style="{StaticResource MutedText}" />
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.28*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Lớp học của tôi" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Danh sách lớp bạn đang phụ trách" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,5"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="ClassCountBadge" Text="0 lớp" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>

                            <ItemsControl x:Name="ClassList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource AppBorderSoftBrush}" BorderThickness="0,0,0,1" Padding="0,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Subject}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,4" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding StudentCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AverageScoreText, StringFormat=ĐTB {0}}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="NoClassText"
                                       Text="Bạn chưa có lớp học nào. Hãy vào mục Quản lý lớp để thêm lớp."
                                       Style="{StaticResource MutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,14,0,4"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Phân bố học lực" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Dựa trên điểm trung bình của sinh viên" Style="{StaticResource MutedText}" Margin="0,3,0,18" />
                            <ItemsControl x:Name="RankList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="82" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="78" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <ProgressBar Grid.Column="1"
                                                         Style="{StaticResource AppProgressBar}"
                                                         Height="9"
                                                         Maximum="100"
                                                         Value="{Binding Percent}"
                                                         Foreground="{Binding Brush}"
                                                         VerticalAlignment="Center"
                                                         Margin="8,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sinh viên nổi bật" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Top 5 điểm trung bình cao nhất" Style="{StaticResource MutedText}" Margin="0,3,0,16" />
                            <ItemsControl x:Name="TopStudents">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,13">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Position}"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Student.FullName}"
                                                           FontSize="12.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Student.ClassName}"
                                                           FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,5" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Student.ScoreText}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoTopStudentText"
                                       Text="Chưa có dữ liệu sinh viên."
                                       Style="{StaticResource MutedText}"
                                       Margin="0,5,0,0"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock Text="Trạng thái sinh viên" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Tình trạng học tập hiện tại" Style="{StaticResource MutedText}" Margin="0,3,0,16" />
                            <ItemsControl x:Name="StatusList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,11">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Background="{Binding SoftBrush}" CornerRadius="7" Padding="9,4">
                                                <TextBlock Text="{Binding ValueText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding Brush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
