<UserControl x:Class="QuanLySinhVien.Views.ClassesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Quản lý lớp học" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Tạo và quản lý các lớp học bạn được phân công phụ trách."
                           Style="{StaticResource PageSubtitle}" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryButton}"
                    Height="42"
                    Padding="18,0"
                    VerticalAlignment="Center"
                    Click="AddClass_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="13"
                               Foreground="White"
                               VerticalAlignment="Center" />
                    <TextBlock Text="Thêm lớp học"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tổng số lớp" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatClassesText" Text="0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,0,14,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Tổng sinh viên" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatStudentsText" Text="0" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18">
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource WarningSoftBrush}">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Điểm trung bình chung" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock x:Name="StatAverageText" Text="--" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="330" HorizontalAlignment="Left">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource InputTextBox}"
                             Height="40"
                             Padding="36,0,12,0"
                             TextChanged="SearchBox_TextChanged" />
                    <TextBlock Text="&#xE721;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="13,0,0,0"
                               IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchWatermark"
                               Text="Tìm theo mã lớp, tên lớp, môn học..."
                               FontSize="12.5"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               Margin="36,0,0,0"
                               IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EditClassButton"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="EditClass_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Sửa" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteClassButton"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            IsEnabled="False"
                            Click="DeleteClass_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Xóa" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="20,16,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Danh sách lớp học" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ClassesCountText" Text="0 lớp" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="Nhấn đúp để sửa nhanh" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="ClassesGrid"
                              Style="{StaticResource AppDataGrid}"
                              SelectionChanged="ClassesGrid_SelectionChanged"
                              MouseDoubleClick="ClassesGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="LỚP HỌC" Width="270" SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                            <TextBlock Text="{Binding Id}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="MÔN HỌC" Binding="{Binding Subject}" Width="*" MinWidth="150" />
                            <DataGridTextColumn Header="KHOA / BỘ MÔN" Binding="{Binding Major}" Width="150" />
                            <DataGridTextColumn Header="NIÊN KHÓA" Binding="{Binding SchoolYear}" Width="105" />

                            <DataGridTemplateColumn Header="SĨ SỐ" Width="96" SortMemberPath="StudentCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StudentCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentDarkBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ĐIỂM TB" Width="83" SortMemberPath="AverageScore">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AverageScoreText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="THAO TÁC" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Tag="{Binding}" Click="EditClassRow_Click" ToolTip="Sửa lớp học">
                                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource AccentBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="30" Height="30" Tag="{Binding}" Click="DeleteClassRow_Click" ToolTip="Xóa lớp học">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                        <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource SurfaceSoftBrush}" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="23" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Không tìm thấy lớp học" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Thử thay đổi từ khóa tìm kiếm hoặc thêm lớp mới." FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
