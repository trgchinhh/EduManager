<UserControl x:Class="QuanLySinhVien.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer x:Name="StatisticsPageScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Thống kê và báo cáo" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="ScopeSubtitle" Text="Tổng hợp kết quả học tập của sinh viên." Style="{StaticResource PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Phạm vi:"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0" />
                    <ComboBox x:Name="ScopeFilter"
                              Style="{StaticResource InputComboBox}"
                              Height="40"
                              Width="255"
                              SelectionChanged="ScopeFilter_SelectionChanged" />
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="0,0,0,20">
                <Border Style="{StaticResource Card}" Padding="19" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Sinh viên" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StatTotalText" Text="0" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Trong phạm vi đã chọn" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="19" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Điểm trung bình" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StatAverageText" Text="--" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Thang điểm 10" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="19" Margin="0,0,14,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tỉ lệ đạt" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StatPassRateText" Text="0%" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Điểm từ 5.0 trở lên" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource SuccessSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Padding="19">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Điểm cao nhất" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock x:Name="StatHighestText" Text="--" FontSize="27" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0" />
                            <TextBlock Text="Trong phạm vi đã chọn" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="{DynamicResource PurpleSoftBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource PurpleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ClassChartCard" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Điểm trung bình theo lớp" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="ClassChartSubtitle" Text="So sánh điểm trung bình giữa các lớp" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource SurfaceSoftBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="Thang điểm 10" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,18,0,0" MinHeight="255">
                            <ScrollViewer x:Name="ClassChartScrollViewer" Height="255" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ClassChart" Height="255" HorizontalAlignment="Left">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="5,0" Width="{Binding ItemWidth}">
                                                <Grid Height="196">
                                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding AverageText}"
                                                                   FontSize="12"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,7" />
                                                        <Border Width="{Binding BarWidth}"
                                                                Height="{Binding BarHeight}"
                                                                Background="{Binding Brush}"
                                                                CornerRadius="7,7,2,2"
                                                                HorizontalAlignment="Center">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.22" Color="#0F172A" />
                                                            </Border.Effect>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="{Binding ShortName}"
                                                           FontSize="10.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxWidth="110"
                                                           ToolTip="{Binding FullName}" />
                                                <TextBlock Text="{Binding CountText}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="NoClassChartText"
                                       Text="Chưa có lớp học để thống kê."
                                       Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Xếp loại học lực" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Phân bố sinh viên theo điểm trung bình" Style="{StaticResource MutedText}" Margin="0,3,0,18" />

                        <ItemsControl x:Name="RankList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="90" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <ProgressBar Grid.Column="1"
                                                     Style="{StaticResource AppProgressBar}"
                                                     Height="9"
                                                     Maximum="100"
                                                     Value="{Binding Percent}"
                                                     Foreground="{Binding Brush}"
                                                     VerticalAlignment="Center"
                                                     Margin="8,0,10,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="{DynamicResource SurfaceSoftBrush}" CornerRadius="10" Padding="12" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="14"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="RankSummaryText"
                                           Text="Chưa có dữ liệu."
                                           FontSize="10.5"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="9,0,0,0"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Tỷ lệ học lực theo lớp" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Mỗi biểu đồ thể hiện tỷ lệ sinh viên theo từng mức học lực." Style="{StaticResource MutedText}" Margin="0,3,0,14" />
                    <ItemsControl x:Name="ClassRankCharts">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="214" MinHeight="226" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="14" Margin="0,0,12,10">
                                    <StackPanel>
                                        <Grid Width="148" Height="148" HorizontalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource AppBorderSoftBrush}" />
                                            <ItemsControl Width="148" Height="148" ItemsSource="{Binding Slices}" IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas Width="148" Height="148" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Canvas Width="148" Height="148">
                                                            <Path Width="148" Height="148" Data="{Binding Geometry}" Fill="{Binding Brush}" Stretch="None" Stroke="{DynamicResource SurfaceBrush}" StrokeThickness="1" />
                                                            <TextBlock Canvas.Left="{Binding LabelX}" Canvas.Top="{Binding LabelY}" Width="38" Height="18" Text="{Binding PercentText}" FontSize="9.5" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" />
                                                        </Canvas>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock Text="{Binding StudentCountText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" Margin="0,8,0,0" />
                                        <TextBlock Text="{Binding ClassName}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="NoClassRankChartsText" Text="Chưa có lớp học để thống kê." Style="{StaticResource MutedText}" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sinh viên nổi bật" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="5 điểm trung bình cao nhất trong phạm vi" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock Text="TOP 5" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" />
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="TopStudents" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Position}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Student.FullName}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Student.ClassName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource AccentSoftBrush}" CornerRadius="7" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Student.ScoreText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentDarkBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoTopStudentText" Text="Chưa có dữ liệu sinh viên." Style="{StaticResource MutedText}" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Sinh viên cần chú ý" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Sinh viên có điểm trung bình dưới 5.0" Style="{StaticResource MutedText}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="8" Padding="9,4" VerticalAlignment="Center">
                                <TextBlock x:Name="RiskCountText" Text="0" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                            </Border>
                        </Grid>

                        <ItemsControl x:Name="RiskStudents" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource DangerSoftBrush}" CornerRadius="9" Padding="10,8" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ClassName}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerSoftBrush}" CornerRadius="7" Padding="8,4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ScoreText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="NoRiskText"
                                   Text="Tất cả sinh viên đều đạt. Tuyệt vời!"
                                   Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
